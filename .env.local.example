# Copiá este archivo a `.env.local` y completá con los datos de tu proyecto.
# Dashboard de Supabase → Project Settings → API.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY
# (Opcional, solo servidor) Clave `service_role`. NO exponer con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Multitenant ---
# Tienda destacada por defecto en el panel maestro (/admin).
# El panel de cada tienda vive en /[storeSlug]/admin.
NEXT_PUBLIC_ADMIN_STORE_SLUG=ag-mayorista
# URL pública usada por Mercado Pago para volver a la tienda.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago (solo servidor; NO usar prefijo NEXT_PUBLIC_) ---
# Sin este token, el checkout MERCADO_PAGO muestra un fallback por WhatsApp.
MERCADO_PAGO_ACCESS_TOKEN=

# --- WhatsApp de pruebas (solo dígitos, con código de país) ---
NEXT_PUBLIC_STORE_WHATSAPP=5491123456789

# --- Fallback de marca si Supabase no está disponible (lib/store.ts) ---
NEXT_PUBLIC_STORE_NAME=aura-studio
NEXT_PUBLIC_STORE_SUBTITLE=Ventas por mayor y menor
NEXT_PUBLIC_STORE_SLOGAN=Donde cuidar tu bolsillo también es invertir en tu futuro.
NEXT_PUBLIC_STORE_ALIAS=almacen.barrio.mp
NEXT_PUBLIC_STORE_CBU=0000000000000000000000
NEXT_PUBLIC_STORE_TITULAR=Nombre del Titular

# --- Cloudinary (subida no firmada de imágenes de productos) ---
# Cloud name del dashboard de Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
# Upload preset SIN FIRMA (Settings → Upload → Upload presets), modo Unsigned,
# restringido a imágenes.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=almacen_unsigned
