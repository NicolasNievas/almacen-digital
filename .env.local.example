# Copiá este archivo a `.env.local` y completá con los datos de tu proyecto Supabase.
# Dashboard de Supabase → Project Settings → API.

# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública `anon` (anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# (Opcional, solo servidor) Clave `service_role`. NO exponer con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
